{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-spanish-git.mjs\"",
            "statusMessage": "Verificando que el commit/rama esté en inglés..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-task-prefix.mjs\"",
            "statusMessage": "Verificando prefijo UI-<n> en rama y commit..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-claude-signature.mjs\"",
            "statusMessage": "Verificando que no haya firma de Claude en commits..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-color-props.mjs\"",
            "statusMessage": "Verificando convención de props de color..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-native-scroll.mjs\"",
            "statusMessage": "Verificando scroll nativo..."
          }
        ]
      }
    ]
  }
}
